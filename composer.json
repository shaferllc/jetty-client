{
    "name": "jetty/client",
    "description": "Share your localhost over a public HTTPS URL. The Jetty CLI: tunnels, request inspection, and shareable galleries.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://usejetty.online",
    "support": {
        "docs": "https://usejetty.online/docs",
        "issues": "https://github.com/shaferllc/jetty-client/issues"
    },
    "keywords": [
        "jetty",
        "tunnel",
        "cli",
        "api"
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "composer-runtime-api": "^2.2",
        "amphp/websocket-client": "^2.0"
    },
    "suggest": {
        "ext-openssl": "For `wss://` edge WebSocket URLs (`jetty share`)",
        "ext-pcntl": "For clean Ctrl+C handling when running `jetty share`",
        "ext-zlib": "Required to run the gzipped PHAR build (`composer run build-phar`)"
    },
    "bin": [
        "bin/jetty"
    ],
    "autoload": {
        "psr-4": {
            "JettyCli\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "humbug/box": "^4.6",
        "laravel/pint": "^1.29",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "build-phar": "box compile --no-interaction",
        "test": "phpunit",
        "jetty": "php bin/jetty"
    },
    "autoload-dev": {
        "psr-4": {
            "JettyCli\\Tests\\": "tests/"
        }
    },
    "replace": {
        "jetty/php-cli": "*"
    }
}
